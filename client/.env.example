# URL of the Express API
# For Vercel frontend deploys, set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://cyberspark-api.vercel.app
VITE_API_URL=http://localhost:4000

# Supabase (for admin sign-in)
# Create a project and copy the Project URL and anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
