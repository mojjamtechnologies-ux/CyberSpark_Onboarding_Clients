# Production environment template for the backend
# Copy to .env and fill in your values

PORT=4000

# Frontend URL deployed on Vercel
CLIENT_ORIGIN=https://your-project.vercel.app

# Set to 1 when behind a proxy (required for Vercel, Railway, Render, etc.)
TRUST_PROXY=1

# Supabase credentials (from Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_BUCKET=payment-proofs

# Strong random token for admin dashboard
# Generate with: openssl rand -base64 32
ADMIN_ACCESS_TOKEN=change-this-to-a-strong-secret-token

# Bank details (update with your real information)
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=CyberSpark IT Solutions
BANK_ACCOUNT_NUMBER=0000000000
PAYMENT_NOTE=Use your full name as the transfer narration, then upload the receipt.
